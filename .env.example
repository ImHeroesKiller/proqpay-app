# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Auth.js (server only)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3001"
AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Supabase project (public URL + anon key are browser-safe)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase service role — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Prisma → Supabase PostgreSQL
# Transaction pooler (port 6543) for app queries
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true"
# Session pooler (port 5432) for migrations / Prisma directUrl
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Production (Vercel) — set these in the Vercel dashboard, do not commit secrets
# ---------------------------------------------------------------------------
# AUTH_SECRET=<openssl rand -base64 32>
# AUTH_TRUST_HOST=true
# NEXTAUTH_URL=https://proqpay.msg-os.com
# AUTH_URL=https://proqpay.msg-os.com
# NEXT_PUBLIC_APP_URL=https://proqpay.msg-os.com
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...
# DATABASE_URL=...pooler...:6543/...?sslmode=require&pgbouncer=true
# DIRECT_URL=...pooler...:5432/...?sslmode=require
#
# Domains:
#   Corporate site  → https://www.msg-os.com   (proqpay-website)
#   ProQPay app     → https://proqpay.msg-os.com  (this repo)

# ---------------------------------------------------------------------------
# ProQ AI — Gemini worker pool (server only, never NEXT_PUBLIC_*)
# Round-robin gemini-worker-1…5 → Flash Lite fallback
# ---------------------------------------------------------------------------
# GEMINI_WORKER_1=
# GEMINI_WORKER_2=
# GEMINI_WORKER_3=
# GEMINI_WORKER_4=
# GEMINI_WORKER_5=
# GEMINI_API_KEY=                 # Flash Lite / pool fallback
# GEMINI_PRIMARY_MODEL=gemini-3.1-flash
# GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_TIMEOUT_MS=5000
