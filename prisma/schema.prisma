  flatFee          Decimal?               @map("flat_fee") @db.Decimal(18, 2)
  minimumFee       Decimal?               @map("minimum_fee") @db.Decimal(18, 2)
  maximumFee       Decimal?               @map("maximum_fee") @db.Decimal(18, 2)
