  createdById     String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  formula         PayrollFormula @relation(fields: [formulaId], references: [id], onDelete: Cascade)

  @@unique([formulaId, version])
  @@index([formulaId])
  @@map("payroll_formula_versions")
  @@schema("proqpay")
}

model PayrollCalculation {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @map("company_id") @db.Uuid
  payrollPeriodId String?        @map("payroll_period_id") @db.Uuid
  revision        Int            @default(1)
  status          EngineRunStatus @default(DRAFT)
  employeeCount   Int            @default(0) @map("employee_count")
  grossTotal      Decimal        @default(0) @map("gross_total") @db.Decimal(18, 2)
  netTotal        Decimal        @default(0) @map("net_total") @db.Decimal(18, 2)
  employerCost    Decimal        @default(0) @map("employer_cost") @db.Decimal(18, 2)
  fundingRequirement Decimal     @default(0) @map("funding_requirement") @db.Decimal(18, 2)
  workingCapitalRequirement Decimal @default(0) @map("working_capital_requirement") @db.Decimal(18, 2)
  expectedClientFunding Decimal  @default(0) @map("expected_client_funding") @db.Decimal(18, 2)
  formulaVersionIds String?      @map("formula_version_ids")
  errorMessage    String?        @map("error_message")
  calculatedAt    DateTime?      @map("calculated_at")
  createdById     String?        @map("created_by") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  company         Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items           PayrollCalculationItem[]
  snapshot        PayrollSnapshot?
  validations     PayrollValidation[]
  approvals       PayrollApproval[]
  revisions       PayrollRevision[]
  journal         PayrollJournal?

  @@index([companyId])
  @@index([payrollPeriodId])
  @@index([status])
  @@map("payroll_calculations")
  @@schema("proqpay")
}

model PayrollCalculationItem {
  id               String   @id @default(uuid()) @db.Uuid
  calculationId    String   @map("calculation_id") @db.Uuid
  employeeId       String?  @map("employee_id") @db.Uuid
  employeeCode     String?  @map("employee_code")
  employeeName     String   @map("employee_name")
  componentCode    String   @map("component_code")
  componentName    String   @map("component_name")
  formulaSource    String?  @map("formula_source")
  calculatedValue  Decimal  @default(0) @map("calculated_value") @db.Decimal(18, 2)
  manualOverride   Decimal? @map("manual_override") @db.Decimal(18, 2)
  finalValue       Decimal  @default(0) @map("final_value") @db.Decimal(18, 2)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  calculation      PayrollCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@index([calculationId])
  @@index([employeeId])
  @@map("payroll_calculation_items")
  @@schema("proqpay")
}

/// Immutable snapshot of a finished calculation (JSON payload).
model PayrollSnapshot {
  id            String   @id @default(uuid()) @db.Uuid
  calculationId String   @unique @map("calculation_id") @db.Uuid
  revision      Int      @default(1)
  payloadJson   String   @map("payload_json")
  checksum      String?
  createdAt     DateTime @default(now()) @map("created_at")
  calculation   PayrollCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@map("payroll_snapshots")
  @@schema("proqpay")
}

