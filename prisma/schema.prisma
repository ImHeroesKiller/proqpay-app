// ProQPay Enterprise Payroll OS
// Schema: proqpay on Supabase PostgreSQL
// Models: client-funded payroll + optional working capital + internal commercial ops

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["proqpay"]
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  PAYROLL_ADMIN
  PAYROLL_OPERATOR
  FINANCE
  HR
  DIRECTOR
  APPROVER
  AUDITOR
  VIEWER
  /// Phase 1A financial roles (additive — existing roles retained)
  FINANCE_MANAGER
  FINANCE_STAFF
  PAYROLL_MANAGER
  CLIENT

  @@schema("proqpay")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED

  @@schema("proqpay")
}

enum AttendanceType {
  PRESENT
  ABSENT
  LATE
  LEAVE
  SICK
  PERMISSION
  OVERTIME
  HOLIDAY

  @@schema("proqpay")
}

enum PayrollComponentKind {
  BASIC
  ALLOWANCE
  TRANSPORT
  MEAL
  OVERTIME
  BONUS
  INCENTIVE
  COMMISSION
  LOAN
  DEDUCTION
  FINE
  OTHER_INCOME
  OTHER_DEDUCTION
  BPJS_EMPLOYEE
  BPJS_EMPLOYER
  PPH21

  @@schema("proqpay")
}

enum ComponentCalcMethod {
  FIXED
  PERCENT_OF_BASIC
  PERCENT_OF_GROSS
  FORMULA
  ATTENDANCE_BASED

  @@schema("proqpay")
}

enum PayrollStatus {
  DRAFT
  WAITING
  APPROVED
  REJECTED
  LOCKED
  DISBURSED
  /// Confirmation-engine lifecycle (additive)
  PAYMENT_INSTRUCTION_GENERATED
  WAITING_CLIENT_TRANSFER
  TRANSFER_PROOF_UPLOADED
  UNDER_VERIFICATION
  VERIFIED
  CLOSED

  @@schema("proqpay")
}

enum PaymentConfirmationStatus {
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  NEED_REVISION

  @@schema("proqpay")
}

/// How the client executes salary transfers after the instruction is issued.
enum PaymentExecutionModel {
  CLIENT_SELF_TRANSFER
  WORKING_CAPITAL
  BANK_API
  MANUAL

  @@schema("proqpay")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("proqpay")
}

enum DisbursementStatus {
  PENDING
  PAID
  FAILED

  @@schema("proqpay")
}

/// Legacy + expanded working-capital lifecycle (additive).
enum WorkingCapitalStatus {
  REQUESTED
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  ALLOCATING
  DISBURSED
  FUNDED
  OUTSTANDING
  SETTLEMENT_DUE
  PARTIALLY_REPAID
  REPAID
  OVERDUE
  CANCELLED

  @@schema("proqpay")
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  RESIGNED
  TERMINATED

  @@schema("proqpay")
}

enum PayrollFundingModel {
  SELF_FUNDED
  WORKING_CAPITAL

  @@schema("proqpay")
}

enum ClientLifecycleStatus {
  LEAD
  PROSPECT
  ONBOARDING
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED

  @@schema("proqpay")
}

enum WorkingCapitalFacilityStatus {
  NOT_ENABLED
  ENABLED
  SUSPENDED
  EXHAUSTED

  @@schema("proqpay")
}

enum BankAccountPurpose {
  CLIENT_PAYROLL_SOURCE
  PROQPAY_OPERATIONAL
  FUNDING_SOURCE
  SETTLEMENT
  COLLECTION
  OTHER

  @@schema("proqpay")
}

enum BankAccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@schema("proqpay")
}

enum PaymentExecutionType {
  CLIENT_BANK_TRANSFER
  PROQPAY_MANAGED_TRANSFER
  FUNDING_PARTNER_TRANSFER
  BANK_FILE_EXPORT
  BANK_API_TRANSFER
  MANUAL_EXTERNAL_TRANSFER

  @@schema("proqpay")
}

enum BankingIntegrationStatus {
  SIMULATED
  FILE_BASED
  API_CONNECTED
  MANUAL_CONFIRMATION

  @@schema("proqpay")
}

enum PeriodFundingStatus {
  NOT_REQUIRED
  NOT_STARTED
  REQUESTED
  UNDER_REVIEW
  APPROVED
  ALLOCATED
  FUNDED
  REJECTED
  SETTLED

  @@schema("proqpay")
}

enum PaymentInstructionStatus {
  NOT_STARTED
  DRAFT
  READY
  SUBMITTED
  PROCESSING
  EXECUTED
  PARTIALLY_FAILED
  FAILED
  CANCELLED

  @@schema("proqpay")
}

enum ReconciliationStatus {
  NOT_STARTED
  IN_PROGRESS
  RECONCILED
  EXCEPTION

  @@schema("proqpay")
}

enum InstructionItemStatus {
  PENDING
  VALIDATED
  READY
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  REVERSED

  @@schema("proqpay")
}

enum SettlementStatus {
  NOT_STARTED
  PENDING
  PARTIAL
  COMPLETE
  OVERDUE
  WRITTEN_OFF

  @@schema("proqpay")
}

enum SalesStage {
  LEAD
  QUALIFIED
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  VERBAL_COMMITMENT
  WON
  LOST
  ON_HOLD

  @@schema("proqpay")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
  ARCHIVED

  @@schema("proqpay")
}

enum PricingType {
  PERCENTAGE_OF_PAYROLL
  FLAT_PER_PAYROLL
  PER_EMPLOYEE
  DISBURSEMENT_FEE
  WORKING_CAPITAL_FEE
  CUSTOM

  @@schema("proqpay")
}

enum PricingCalculationBase {
  GROSS_PAYROLL
  NET_PAYROLL
  FUNDED_AMOUNT
  DISBURSED_AMOUNT
  EMPLOYEE_COUNT
  FIXED

  @@schema("proqpay")
}

enum PricingRuleStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  EXPIRED

  @@schema("proqpay")
}

enum CapitalPartnerStatus {
  PROSPECT
  DUE_DILIGENCE
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED

  @@schema("proqpay")
}

enum AgreementStatus {
  NOT_STARTED
  DRAFT
  REVIEW
  SIGNED
  EXPIRED
  TERMINATED

  @@schema("proqpay")
}

enum AllocationStatus {
  PROPOSED
  APPROVED
  FUNDED
  SETTLED
  CANCELLED

  @@schema("proqpay")
}

// ─── Core multi-tenant ───────────────────────────────────

model Organization {
  id              String             @id @default(uuid()) @db.Uuid
  name            String
  slug            String             @unique
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  companies       Company[]
  users           User[]
  salesOpportunities SalesOpportunity[]
  capitalPartners CapitalPartner[]
  invoiceSequences InvoiceSequence[]
  treasuryAccounts TreasuryAccount[]
  fundingSources   FundingSource[]

  @@map("organizations")
  @@schema("proqpay")
}

model Company {
  id                      String                       @id @default(uuid()) @db.Uuid
  organizationId          String                       @map("organization_id") @db.Uuid
  name                    String
  legalName               String?                      @map("legal_name")
  npwp                    String?
  address                 String?
  lifecycleStatus         ClientLifecycleStatus        @default(ACTIVE) @map("lifecycle_status")
  clientType              String?                      @map("client_type")
  industry                String?
  employeeRange           String?                      @map("employee_range")
  estimatedMonthlyPayroll Decimal?                     @map("estimated_monthly_payroll") @db.Decimal(18, 2)
  actualManagedPayroll    Decimal?                     @map("actual_managed_payroll") @db.Decimal(18, 2)
  defaultFundingModel     PayrollFundingModel          @default(SELF_FUNDED) @map("default_funding_model")
  fundingEnabled          Boolean                      @default(true) @map("funding_enabled")
  workingCapitalLimit     Decimal?                     @map("working_capital_limit") @db.Decimal(18, 2)
  workingCapitalStatus    WorkingCapitalFacilityStatus @default(NOT_ENABLED) @map("working_capital_status")
  goLiveDate              DateTime?                    @map("go_live_date") @db.Date
  accountOwnerUserId      String?                      @map("account_owner_user_id") @db.Uuid
  source                  String?
  internalNotes           String?                      @map("internal_notes")
  createdAt               DateTime                     @default(now()) @map("created_at")
  updatedAt               DateTime                     @updatedAt @map("updated_at")
  organization            Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountOwner            User?                        @relation("CompanyAccountOwner", fields: [accountOwnerUserId], references: [id], onDelete: SetNull)
  employees               Employee[]
  payrollPeriods          PayrollPeriod[]
  bankAccounts            BankAccount[]
  users                   User[]                       @relation("UserCompany")
  paymentInstructions     PaymentInstruction[]
  paymentConfirmations    PaymentConfirmation[]
  workingCapitalRequests  WorkingCapitalRequest[]
  salesOpportunities      SalesOpportunity[]
  pricingRules            PricingRule[]
  notifications           AppNotification[]
  auditLogs               AuditLog[]
  branches                Branch[]
  departments             Department[]
  positions               Position[]
  costCenters             CostCenter[]
  projects                Project[]
  attendanceRecords       AttendanceRecord[]
  payrollComponents       PayrollComponent[]
  approvalMatrices        ApprovalMatrix[]
  holidayCalendars        HolidayCalendar[]
  taxConfigs              TaxConfig[]
  bpjsConfigs             BpjsConfig[]
  loginHistories          LoginHistory[]
  invoices                Invoice[]
  clientPayments          ClientPayment[]
  receivables             Receivable[]
  collectionActivities    CollectionActivity[]
  financialAttachments    FinancialAttachment[]
  financialAudits         FinancialAudit[]
  cashMovements           CashMovement[]
  treasuryAccounts        TreasuryAccount[]
  billingProfile          ClientBillingProfile?
  payrollFormulas         PayrollFormula[]
  payrollCalculations     PayrollCalculation[]
  payrollSimulations      PayrollSimulation[]
  payrollApprovals        PayrollApproval[]
  payrollJournals         PayrollJournal[]
  payrollBudgets          PayrollBudget[]
  payrollComponentCategories PayrollComponentCategory[]

  @@index([organizationId])
  @@index([lifecycleStatus])
  @@map("companies")
  @@schema("proqpay")
}

model User {
  id                    String              @id @default(uuid()) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  companyId             String?             @map("company_id") @db.Uuid
  email                 String              @unique
  name                  String
  passwordHash          String              @map("password_hash")
  role                  Role                @default(VIEWER)
  department            String?
  avatarInitials        String              @map("avatar_initials")
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company               Company?            @relation("UserCompany", fields: [companyId], references: [id], onDelete: SetNull)
  ownedCompanies        Company[]           @relation("CompanyAccountOwner")
  auditLogs             AuditLog[]
  approvalSteps         ApprovalStep[]
  salesOwned            SalesOpportunity[]  @relation("SalesOwner")
  pricingCreated        PricingRule[]       @relation("PricingCreatedBy")
  pricingApproved       PricingRule[]       @relation("PricingApprovedBy")
  paymentInstructionsGen PaymentInstruction[] @relation("PaymentInstructionGeneratedBy")
  confirmationsUploaded PaymentConfirmation[] @relation("ConfirmationUploadedBy")
  confirmationsVerified PaymentConfirmation[] @relation("ConfirmationVerifiedBy")
  notifications         AppNotification[]
  wcCreated             WorkingCapitalRequest[] @relation("WcCreatedBy")
  wcReviewed            WorkingCapitalRequest[] @relation("WcReviewedBy")
  wcApproved            WorkingCapitalRequest[] @relation("WcApprovedBy")

  @@index([organizationId])
  @@index([companyId])
  @@map("users")
  @@schema("proqpay")
}

model Employee {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  employeeCode    String           @map("employee_code")
  name            String
  email           String
  phone           String
  department      String
  position        String
  joinDate        DateTime         @map("join_date") @db.Date
  status          EmploymentStatus @default(ACTIVE)
  baseSalary      Decimal          @map("base_salary") @db.Decimal(18, 2)
  bankName        String           @map("bank_name")
  bankAccount     String           @map("bank_account")
  taxStatus       String           @map("tax_status")
  bpjsNumber      String           @map("bpjs_number")
  npwp            String
  /// Extended Indonesian payroll profile (additive)
  branchId        String?          @map("branch_id") @db.Uuid
  departmentId    String?          @map("department_id") @db.Uuid
  positionId      String?          @map("position_id") @db.Uuid
  costCenterId    String?          @map("cost_center_id") @db.Uuid
  grade           String?
  identityNumber  String?          @map("identity_number")
  bpjsKesehatan   String?          @map("bpjs_kesehatan")
  bpjsTk          String?          @map("bpjs_tk")
  ptkpStatus      String?          @map("ptkp_status")
  taxMethod       String?          @map("tax_method") // GROSS | NET | GROSS_UP
  contractType    String?          @map("contract_type")
  contractEnd     DateTime?        @map("contract_end") @db.Date
  terminateDate   DateTime?        @map("terminate_date") @db.Date
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentRef   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionRef     Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  costCenter      CostCenter?      @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  payrollLines    PayrollLine[]
  paymentItems    PaymentInstructionItem[]
  projectAssignments ProjectAssignment[]
  attendanceRecords AttendanceRecord[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([department])
  @@map("employees")
  @@schema("proqpay")
}

// ─── Payroll ─────────────────────────────────────────────

model PayrollPeriod {
  id                       String                   @id @default(uuid()) @db.Uuid
  companyId                String                   @map("company_id") @db.Uuid
  name                     String
  periodStart              DateTime                 @map("period_start") @db.Date
  periodEnd                DateTime                 @map("period_end") @db.Date
  payDate                  DateTime                 @map("pay_date") @db.Date
  status                   PayrollStatus            @default(DRAFT)
  fundingModel             PayrollFundingModel      @default(SELF_FUNDED) @map("funding_model")
  sourceBankAccountId      String?                  @map("source_bank_account_id") @db.Uuid
  executionType            PaymentExecutionType     @default(CLIENT_BANK_TRANSFER) @map("execution_type")
  fundingStatus            PeriodFundingStatus      @default(NOT_REQUIRED) @map("funding_status")
  paymentInstructionStatus PaymentInstructionStatus @default(NOT_STARTED) @map("payment_instruction_status")
  reconciliationStatus     ReconciliationStatus     @default(NOT_STARTED) @map("reconciliation_status")
  confirmationStatus       PaymentConfirmationStatus? @map("confirmation_status")
  employeeCount            Int                      @default(0) @map("employee_count")
  totalGross               Decimal                  @default(0) @map("total_gross") @db.Decimal(18, 2)
  totalDeductions          Decimal                  @default(0) @map("total_deductions") @db.Decimal(18, 2)
  totalNet                 Decimal                  @default(0) @map("total_net") @db.Decimal(18, 2)
  totalBpjsEmployee        Decimal                  @default(0) @map("total_bpjs_employee") @db.Decimal(18, 2)
  totalBpjsEmployer        Decimal                  @default(0) @map("total_bpjs_employer") @db.Decimal(18, 2)
  totalPph21               Decimal                  @default(0) @map("total_pph21") @db.Decimal(18, 2)
  version                  Int                      @default(1)
  lockedAt                 DateTime?                @map("locked_at")
  projectId                String?                  @map("project_id") @db.Uuid
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  company                  Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project                  Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  sourceBankAccount        BankAccount?             @relation("PayrollSourceAccount", fields: [sourceBankAccountId], references: [id], onDelete: SetNull)
  lines                    PayrollLine[]
  approvals                ApprovalStep[]
  disbursements            DisbursementBatch[]
  workingCapital           WorkingCapitalRequest[]
  paymentInstructions      PaymentInstruction[]
  paymentConfirmations     PaymentConfirmation[]
  invoices                 Invoice[]

  @@index([companyId])
  @@index([status])
  @@index([fundingModel])
  @@index([projectId])
  @@map("payroll_periods")
  @@schema("proqpay")
}

model PayrollLine {
  id              String        @id @default(uuid()) @db.Uuid
  payrollPeriodId String        @map("payroll_period_id") @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  employeeName    String        @map("employee_name")
  department      String
  baseSalary      Decimal       @map("base_salary") @db.Decimal(18, 2)
  allowances      Decimal       @default(0) @db.Decimal(18, 2)
  overtime        Decimal       @default(0) @db.Decimal(18, 2)
  bonuses         Decimal       @default(0) @db.Decimal(18, 2)
  deductions      Decimal       @default(0) @db.Decimal(18, 2)
  tax             Decimal       @default(0) @db.Decimal(18, 2)
  bpjs            Decimal       @default(0) @db.Decimal(18, 2)
  netPay          Decimal       @map("net_pay") @db.Decimal(18, 2)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  paymentItems    PaymentInstructionItem[]

  @@index([payrollPeriodId])
  @@index([employeeId])
  @@map("payroll_lines")
  @@schema("proqpay")
}

model ApprovalStep {
  id              String         @id @default(uuid()) @db.Uuid
  payrollPeriodId String         @map("payroll_period_id") @db.Uuid
  level           Int
  approverName    String         @map("approver_name")
  role            Role
  status          ApprovalStatus @default(PENDING)
  comment         String?
  actedAt         DateTime?      @map("acted_at")
  userId          String?        @map("user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  payrollPeriod   PayrollPeriod  @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([payrollPeriodId])
  @@map("approval_steps")
  @@schema("proqpay")
}

// Legacy execution batch (kept for compatibility; payment_instructions is primary)
model DisbursementBatch {
  id              String             @id @default(uuid()) @db.Uuid
  payrollPeriodId String             @map("payroll_period_id") @db.Uuid
  periodName      String             @map("period_name")
  bankName        String             @map("bank_name")
  totalAmount     Decimal            @map("total_amount") @db.Decimal(18, 2)
  itemCount       Int                @map("item_count")
  status          DisbursementStatus @default(PENDING)
  referenceNumber String             @map("reference_number")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  processedAt     DateTime?          @map("processed_at")
  payrollPeriod   PayrollPeriod      @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  @@index([payrollPeriodId])
  @@index([status])
  @@map("disbursement_batches")
  @@schema("proqpay")
}

// ─── Bank accounts ───────────────────────────────────────

model BankAccount {
  id                        String             @id @default(uuid()) @db.Uuid
  companyId                 String?            @map("company_id") @db.Uuid
  capitalPartnerId          String?            @map("capital_partner_id") @db.Uuid
  purpose                   BankAccountPurpose @default(OTHER)
  bankCode                  String?            @map("bank_code")
  bank                      String
  accountName               String?            @map("account_name")
  account                   String
  maskedAccountNumber       String?            @map("masked_account_number")
  encryptedAccountReference String?            @map("encrypted_account_reference")
  label                     String
  currency                  String             @default("IDR")
  status                    BankAccountStatus  @default(ACTIVE)
  isPrimary                 Boolean            @default(false) @map("is_primary")
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")
  company                   Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  capitalPartner            CapitalPartner?    @relation(fields: [capitalPartnerId], references: [id], onDelete: SetNull)
  payrollAsSource           PayrollPeriod[]    @relation("PayrollSourceAccount")
  paymentInstructions       PaymentInstruction[] @relation("InstructionSourceAccount")

  @@index([companyId])
  @@index([capitalPartnerId])
  @@index([purpose])
  @@map("bank_accounts")
  @@schema("proqpay")
}

// ─── Payment instructions ────────────────────────────────

model PaymentInstruction {
  id                  String                    @id @default(uuid()) @db.Uuid
  companyId           String                    @map("company_id") @db.Uuid
  payrollPeriodId     String                    @map("payroll_period_id") @db.Uuid
  instructionNumber   String                    @map("instruction_number")
  fundingModel        PayrollFundingModel       @map("funding_model")
  /// Canonical client-transfer model (self-transfer vs WC path)
  executionModel      PaymentExecutionModel     @default(CLIENT_SELF_TRANSFER) @map("execution_model")
  executionType       PaymentExecutionType      @map("execution_type")
  integrationStatus   BankingIntegrationStatus  @default(SIMULATED) @map("integration_status")
  sourceBankAccountId String?                   @map("source_bank_account_id") @db.Uuid
  totalRecords        Int                       @default(0) @map("total_records")
  totalAmount         Decimal                   @default(0) @map("total_amount") @db.Decimal(18, 2)
  currency            String                    @default("IDR")
  approvalStatus      ApprovalStatus            @default(PENDING) @map("approval_status")
  executionStatus     PaymentInstructionStatus  @default(DRAFT) @map("execution_status")
  generatedById       String?                   @map("generated_by") @db.Uuid
  generatedAt         DateTime?                 @map("generated_at")
  submittedAt         DateTime?                 @map("submitted_at")
  executedAt          DateTime?                 @map("executed_at")
  failureReason       String?                   @map("failure_reason")
  version             Int                       @default(1)
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")
  company             Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollPeriod       PayrollPeriod             @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  sourceBankAccount   BankAccount?              @relation("InstructionSourceAccount", fields: [sourceBankAccountId], references: [id], onDelete: SetNull)
  generatedBy         User?                     @relation("PaymentInstructionGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  items               PaymentInstructionItem[]
  paymentConfirmations PaymentConfirmation[]

  @@unique([companyId, instructionNumber])
  @@index([companyId])
  @@index([payrollPeriodId])
  @@index([executionStatus])
  @@map("payment_instructions")
  @@schema("proqpay")
}

model PaymentInstructionItem {
  id                   String                @id @default(uuid()) @db.Uuid
  paymentInstructionId String                @map("payment_instruction_id") @db.Uuid
  payrollLineId        String?               @map("payroll_line_id") @db.Uuid
  employeeId           String?               @map("employee_id") @db.Uuid
  recipientName        String                @map("recipient_name")
  bankCode             String?               @map("bank_code")
  maskedAccountNumber  String                @map("masked_account_number")
  amount               Decimal               @db.Decimal(18, 2)
  status               InstructionItemStatus @default(PENDING)
  externalReference    String?               @map("external_reference")
  failureCode          String?               @map("failure_code")
  failureMessage       String?               @map("failure_message")
  executedAt           DateTime?             @map("executed_at")
  createdAt            DateTime              @default(now()) @map("created_at")
  updatedAt            DateTime              @updatedAt @map("updated_at")
  paymentInstruction   PaymentInstruction    @relation(fields: [paymentInstructionId], references: [id], onDelete: Cascade)
  payrollLine          PayrollLine?          @relation(fields: [payrollLineId], references: [id], onDelete: SetNull)
  employee             Employee?             @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([paymentInstructionId])
  @@index([status])
  @@map("payment_instruction_items")
