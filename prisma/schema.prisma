}

model CapitalAllocation {
  id                      String                @id @default(uuid()) @db.Uuid
  workingCapitalRequestId String                @map("working_capital_request_id") @db.Uuid
  capitalPartnerId        String                @map("capital_partner_id") @db.Uuid
  allocatedAmount         Decimal               @map("allocated_amount") @db.Decimal(18, 2)
