// ═══════════════════════════════════════════════════════════
// Phase 1A — Enterprise Financial Core (additive)
// Source of truth for invoice, AR, payment, WC settlement trail,
// treasury movements. Does not replace payroll/payment-instruction
// operational models.
// ═══════════════════════════════════════════════════════════

enum InvoiceStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CANCELLED

