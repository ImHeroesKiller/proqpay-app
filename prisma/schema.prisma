  resultJson    String?  @map("result_json")
  grossTotal    Decimal  @default(0) @map("gross_total") @db.Decimal(18, 2)
  netTotal      Decimal  @default(0) @map("net_total") @db.Decimal(18, 2)
  employerCost  Decimal  @default(0) @map("employer_cost") @db.Decimal(18, 2)
  workingCapitalRequirement Decimal @default(0) @map("working_capital_requirement") @db.Decimal(18, 2)
  marginImpact  Decimal  @default(0) @map("margin_impact") @db.Decimal(18, 2)
