  @@schema("proqpay")
}

enum PaymentInstructionStatus {
  NOT_STARTED
  DRAFT
  READY
  SUBMITTED
  PROCESSING
  EXECUTED
  PARTIALLY_FAILED
  FAILED
  CANCELLED

