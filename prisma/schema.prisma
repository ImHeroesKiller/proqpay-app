enum EngineRunStatus {
  DRAFT
  CALCULATING
  VALIDATING
  READY_FOR_APPROVAL
  PARTIALLY_APPROVED
  APPROVED
  LOCKED
  CLOSED
  REVISED
  CANCELLED
  FAILED

  @@schema("proqpay")
}

enum FormulaStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@schema("proqpay")
}

enum ValidationSeverity {
  INFO
  WARNING
  ERROR
  BLOCKER

  @@schema("proqpay")
}

enum EngineApprovalAction {
  APPROVE
  REJECT
  REQUEST_REVISION
  COMMENT

  @@schema("proqpay")
}

enum BudgetScopeType {
  COMPANY
  CLIENT
  PROJECT
  SITE

  @@schema("proqpay")
}

enum BillingMethod {
  PAYROLL_SERVICE
  FIXED_FEE
  HYBRID
  OTHER

  @@schema("proqpay")
}

enum InvoiceGrouping {
  PER_PAYROLL
  PER_PROJECT
  PER_SITE
  CONSOLIDATED

  @@schema("proqpay")
}

model ClientBillingProfile {
  id              String          @id @default(uuid()) @db.Uuid
  companyId       String          @unique @map("company_id") @db.Uuid
  billingMethod   BillingMethod   @default(PAYROLL_SERVICE) @map("billing_method")
  topDays         Int             @default(30) @map("top_days")
  invoiceGrouping InvoiceGrouping @default(PER_PAYROLL) @map("invoice_grouping")
  invoicePrefix   String          @default("INV") @map("invoice_prefix")
  currency        String          @default("IDR")
  taxConfiguration String?        @map("tax_configuration")
  notes           String?
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("client_billing_profiles")
  @@schema("proqpay")
}

model PayrollComponentCategory {
  id          String   @id @default(uuid()) @db.Uuid
  companyId   String?  @map("company_id") @db.Uuid
  code        String
  name        String
  displayOrder Int     @default(0) @map("display_order")
  isSystem    Boolean  @default(true) @map("is_system")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  company     Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@map("payroll_component_categories")
  @@schema("proqpay")
}

model PayrollFormula {
  id          String        @id @default(uuid()) @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  code        String
  name        String
  description String?
  status      FormulaStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
