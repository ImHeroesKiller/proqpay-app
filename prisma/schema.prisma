// ProQPay Enterprise Payroll OS
// Schema: proqpay on Supabase PostgreSQL
// Models: client-funded payroll + optional working capital + internal commercial ops

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["proqpay"]
}

