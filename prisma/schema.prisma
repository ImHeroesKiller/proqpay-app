  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year, month, prefix])
  @@map("invoice_sequences")
  @@schema("proqpay")
}

model Invoice {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @map("organization_id") @db.Uuid
  companyId         String        @map("company_id") @db.Uuid
  /// Billing client (company) — same as companyId for single-tenant client rows
  clientId          String        @map("client_id") @db.Uuid
  projectId         String?       @map("project_id") @db.Uuid
  payrollPeriodId   String?       @map("payroll_period_id") @db.Uuid
  invoiceNumber     String?       @map("invoice_number")
  currency          String        @default("IDR")
  issueDate         DateTime?     @map("issue_date") @db.Date
  dueDate           DateTime?     @map("due_date") @db.Date
  status            InvoiceStatus @default(DRAFT)
  subtotal          Decimal       @default(0) @db.Decimal(18, 2)
  tax               Decimal       @default(0) @db.Decimal(18, 2)
  grandTotal        Decimal       @default(0) @map("grand_total") @db.Decimal(18, 2)
  paidAmount        Decimal       @default(0) @map("paid_amount") @db.Decimal(18, 2)
  outstandingAmount Decimal       @default(0) @map("outstanding_amount") @db.Decimal(18, 2)
  notes             String?
  createdById       String?       @map("created_by") @db.Uuid
  approvedById      String?       @map("approved_by") @db.Uuid
  approvedAt        DateTime?     @map("approved_at")
  issuedAt          DateTime?     @map("issued_at")
  cancelledAt       DateTime?     @map("cancelled_at")
  version           Int           @default(1)
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  company           Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project           Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  payrollPeriod     PayrollPeriod? @relation(fields: [payrollPeriodId], references: [id], onDelete: SetNull)
  items             InvoiceItem[]
  receivable        Receivable?
  paymentAllocations PaymentAllocation[]
  collectionActivities CollectionActivity[]
  attachments       FinancialAttachment[]

  @@unique([organizationId, invoiceNumber])
  @@index([companyId])
  @@index([clientId])
  @@index([status])
  @@index([payrollPeriodId])
  @@index([dueDate])
  @@map("invoices")
  @@schema("proqpay")
}

model InvoiceItem {
