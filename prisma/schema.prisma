  capitalPartner          CapitalPartner        @relation(fields: [capitalPartnerId], references: [id], onDelete: Restrict)

  @@index([workingCapitalRequestId])
  @@index([capitalPartnerId])
  @@map("capital_allocations")
  @@schema("proqpay")
}

// ─── Payroll Confirmation Engine ─────────────────────────

model PaymentConfirmation {
  id                    String                    @id @default(uuid()) @db.Uuid
  companyId             String                    @map("company_id") @db.Uuid
  payrollPeriodId       String                    @map("payroll_period_id") @db.Uuid
  paymentInstructionId  String                    @map("payment_instruction_id") @db.Uuid
  confirmationNumber    String                    @map("confirmation_number")
  paymentDate           DateTime                  @map("payment_date") @db.Date
  paymentAmount         Decimal                   @map("payment_amount") @db.Decimal(18, 2)
  payerBank             String                    @map("payer_bank")
  payerAccountName      String                    @map("payer_account_name")
  payerAccountMasked    String                    @map("payer_account_masked")
  referenceNumber       String                    @map("reference_number")
  status                PaymentConfirmationStatus @default(UPLOADED)
  notes                 String?
  rejectionReason       String?                   @map("rejection_reason")
  uploadedById          String?                   @map("uploaded_by") @db.Uuid
  verifiedById          String?                   @map("verified_by") @db.Uuid
  verifiedAt            DateTime?                 @map("verified_at")
  createdAt             DateTime                  @default(now()) @map("created_at")
  updatedAt             DateTime                  @updatedAt @map("updated_at")
  company               Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollPeriod         PayrollPeriod             @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  paymentInstruction    PaymentInstruction        @relation(fields: [paymentInstructionId], references: [id], onDelete: Cascade)
  uploadedBy            User?                     @relation("ConfirmationUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  verifiedBy            User?                     @relation("ConfirmationVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  files                 PaymentConfirmationFile[]

  @@unique([companyId, confirmationNumber])
  @@index([companyId])
  @@index([payrollPeriodId])
  @@index([paymentInstructionId])
  @@index([status])
  @@map("payment_confirmations")
  @@schema("proqpay")
}

model PaymentConfirmationFile {
  id                    String              @id @default(uuid()) @db.Uuid
  paymentConfirmationId String              @map("payment_confirmation_id") @db.Uuid
  storagePath           String              @map("storage_path")
  fileName              String              @map("file_name")
  mimeType              String              @map("mime_type")
  fileSize              Int                 @map("file_size")
  uploadedAt            DateTime            @default(now()) @map("uploaded_at")
  paymentConfirmation   PaymentConfirmation @relation(fields: [paymentConfirmationId], references: [id], onDelete: Cascade)

  @@index([paymentConfirmationId])
  @@map("payment_confirmation_files")
  @@schema("proqpay")
}

model AppNotification {
