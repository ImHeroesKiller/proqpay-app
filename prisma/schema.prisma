// ─── Core organization ───────────────────────────────────

model Organization {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  companies Company[]
  users     User[]

  @@map("organizations")
  @@schema("proqpay")
}

model Company {
  id                        String                       @id @default(uuid()) @db.Uuid
  organizationId            String                       @map("organization_id") @db.Uuid
  name                      String
  legalName                 String?                      @map("legal_name")
  npwp                      String?
  address                   String?
  lifecycleStatus           ClientLifecycleStatus       @default(ACTIVE) @map("lifecycle_status")
  industry                  String?
  clientType                String?                      @map("client_type")
  employeeRange             String?                      @map("employee_range")
  estimatedMonthlyPayroll   Decimal?                     @map("estimated_monthly_payroll") @db.Decimal(18, 2)
  actualManagedPayroll      Decimal?                     @map("actual_managed_payroll") @db.Decimal(18, 2)
  workingCapitalLimit       Decimal?                     @map("working_capital_limit") @db.Decimal(18, 2)
  annualContractValue       Decimal?                     @map("annual_contract_value") @db.Decimal(18, 2)
  defaultFundingModel       PayrollFundingModel          @default(SELF_FUNDED) @map("default_funding_model")
  fundingEnabled            Boolean                      @default(true) @map("funding_enabled")
  workingCapitalStatus      WorkingCapitalFacilityStatus @default(NOT_ENABLED) @map("working_capital_status")
  accountOwnerUserId        String?                      @map("account_owner_user_id") @db.Uuid
  source                    String?
  goLiveDate                DateTime?                    @map("go_live_date") @db.Date
  internalNotes             String?                      @map("internal_notes")
  createdAt                 DateTime                     @default(now()) @map("created_at")
  updatedAt                 DateTime                     @updatedAt @map("updated_at")
  organization              Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountOwner              User?                        @relation("CompanyAccountOwner", fields: [accountOwnerUserId], references: [id], onDelete: SetNull)
  users                     User[]
  employees                 Employee[]
  payrollPeriods            PayrollPeriod[]
  bankAccounts              BankAccount[]
  paymentInstructions       PaymentInstruction[]
  paymentConfirmations      PaymentConfirmation[]
  workingCapitalRequests    WorkingCapitalRequest[]
  projects                  Project[]
  attendanceRecords         AttendanceRecord[]
  payrollComponents         PayrollComponent[]
  taxConfigs                TaxConfig[]
  bpjsConfigs               BpjsConfig[]
  loginHistories            LoginHistory[]
  auditLogs                 AuditLog[]
  branches                  Branch[]
  departments               Department[]
  positions                 Position[]
  costCenters               CostCenter[]
  holidayCalendars          HolidayCalendar[]
  approvalMatrices          ApprovalMatrix[]
  salesOpportunities        SalesOpportunity[]
  pricingRules              PricingRule[]
  invoices                  Invoice[]
  clientPayments            ClientPayment[]
  receivables               Receivable[]
  treasuryAccounts          TreasuryAccount[]
  cashMovements             CashMovement[]
  collectionActivities      CollectionActivity[]
  financialAttachments      FinancialAttachment[]
  financialAudits           FinancialAudit[]
  billingProfile            ClientBillingProfile?
  payrollFormulas           PayrollFormula[]
  payrollCalculations       PayrollCalculation[]
  payrollSimulations        PayrollSimulation[]
  payrollApprovals          PayrollApproval[]
  payrollJournals           PayrollJournal[]
  payrollBudgets            PayrollBudget[]
  payCycles                 PayCycle[]
  payrollGroups             PayrollGroup[]
  payrollAssignments        EmployeePayrollAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([lifecycleStatus])
  @@map("companies")
  @@schema("proqpay")
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  companyId      String?  @map("company_id") @db.Uuid
  email          String   @unique
  name           String
  passwordHash   String   @map("password_hash")
  role           Role     @default(VIEWER)
  department     String?
  avatarInitials String   @map("avatar_initials")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  approvalSteps  ApprovalStep[]
  auditLogs      AuditLog[]
  ownedCompanies Company[] @relation("CompanyAccountOwner")
  generatedInstructions PaymentInstruction[] @relation("InstructionGeneratedBy")
  createdWcRequests WorkingCapitalRequest[] @relation("WcCreatedBy")
  reviewedWcRequests WorkingCapitalRequest[] @relation("WcReviewedBy")
  approvedWcRequests WorkingCapitalRequest[] @relation("WcApprovedBy")
  ownedOpportunities SalesOpportunity[] @relation("SalesOwner")
  createdPricingRules PricingRule[] @relation("PricingCreatedBy")
  approvedPricingRules PricingRule[] @relation("PricingApprovedBy")
  uploadedConfirmations PaymentConfirmation[] @relation("ConfirmationUploadedBy")
  verifiedConfirmations PaymentConfirmation[] @relation("ConfirmationVerifiedBy")
  notifications AppNotification[]
  lockedPayrollPeriods PayrollPeriod[] @relation("PayrollPeriodLockedBy")

  @@index([organizationId])
  @@index([companyId])
  @@index([role])
  @@map("users")
  @@schema("proqpay")
}

// ─── Projects & workforce ────────────────────────────────

model Project {
  id            String        @id @default(uuid()) @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  clientName    String        @map("client_name")
  code          String
  name          String
  site          String?
  location      String?
  contractRef   String?       @map("contract_ref")
  status        ProjectStatus @default(ACTIVE)
  startDate     DateTime?     @map("start_date") @db.Date
  endDate       DateTime?     @map("end_date") @db.Date
  branchId      String?       @map("branch_id") @db.Uuid
  costCenterId  String?       @map("cost_center_id") @db.Uuid
  serviceType   String?       @map("service_type")
  operationalPic String?      @map("operational_pic")
  headcountQuota Int?         @map("headcount_quota")
  projectBudget Decimal?      @map("project_budget") @db.Decimal(18, 2)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch        Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  costCenter    CostCenter?   @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  assignments   ProjectAssignment[]
  attendanceRecords AttendanceRecord[]
  payrollPeriods PayrollPeriod[]
  invoices      Invoice[]
  sites         Site[]
  payrollGroups PayrollGroup[]
  payrollAssignments EmployeePayrollAssignment[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([status])
  @@map("projects")
  @@schema("proqpay")
}

model ProjectAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  employeeId String   @map("employee_id") @db.Uuid
  roleLabel  String?  @map("role_label")
  startDate  DateTime @map("start_date") @db.Date
  endDate    DateTime? @map("end_date") @db.Date
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([projectId, employeeId, startDate])
  @@index([projectId])
  @@index([employeeId])
  @@map("project_assignments")
  @@schema("proqpay")
}

model Employee {
  id              String           @id @default(uuid()) @db.Uuid
  companyId       String           @map("company_id") @db.Uuid
  employeeCode    String           @map("employee_code")
  name            String
  email           String
  phone           String
  department      String
  position        String
  joinDate        DateTime         @map("join_date") @db.Date
  status          EmploymentStatus @default(ACTIVE)
  baseSalary      Decimal          @map("base_salary") @db.Decimal(18, 2)
  bankName        String           @map("bank_name")
  bankAccount     String           @map("bank_account")
  taxStatus       String           @map("tax_status")
  bpjsNumber      String           @map("bpjs_number")
  npwp            String
  branchId        String?          @map("branch_id") @db.Uuid
  departmentId    String?          @map("department_id") @db.Uuid
  positionId      String?          @map("position_id") @db.Uuid
  costCenterId    String?          @map("cost_center_id") @db.Uuid
  grade           String?
  identityNumber  String?          @map("identity_number")
  bpjsKesehatan   String?          @map("bpjs_kesehatan")
  bpjsTk          String?          @map("bpjs_tk")
  ptkpStatus      String?          @map("ptkp_status")
  taxMethod       String?          @map("tax_method") // GROSS | NET | GROSS_UP
  contractType    String?          @map("contract_type")
  contractEnd     DateTime?        @map("contract_end") @db.Date
  terminateDate   DateTime?        @map("terminate_date") @db.Date
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch          Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  departmentRef   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  positionRef     Position?        @relation(fields: [positionId], references: [id], onDelete: SetNull)
  costCenter      CostCenter?      @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  /// Payroll group is historical via assignments — not a column on employees
  payrollAssignments EmployeePayrollAssignment[]
  payrollLines    PayrollLine[]
  paymentItems    PaymentInstructionItem[]
  projectAssignments ProjectAssignment[]
  attendanceRecords AttendanceRecord[]
  payslips        Payslip[]

  @@unique([companyId, employeeCode])
  @@index([companyId])
  @@index([department])
  @@map("employees")
  @@schema("proqpay")
}

// ─── Payroll ─────────────────────────────────────────────

model PayrollPeriod {
  id                       String                   @id @default(uuid()) @db.Uuid
  companyId                String                   @map("company_id") @db.Uuid
  name                     String
  periodStart              DateTime                 @map("period_start") @db.Date
  periodEnd                DateTime                 @map("period_end") @db.Date
  payDate                  DateTime                 @map("pay_date") @db.Date
  status                   PayrollStatus            @default(DRAFT)
  fundingModel             PayrollFundingModel      @default(SELF_FUNDED) @map("funding_model")
  sourceBankAccountId      String?                  @map("source_bank_account_id") @db.Uuid
  executionType            PaymentExecutionType     @default(CLIENT_BANK_TRANSFER) @map("execution_type")
  fundingStatus            PeriodFundingStatus      @default(NOT_REQUIRED) @map("funding_status")
  paymentInstructionStatus PaymentInstructionStatus @default(NOT_STARTED) @map("payment_instruction_status")
  reconciliationStatus     ReconciliationStatus     @default(NOT_STARTED) @map("reconciliation_status")
  confirmationStatus       PaymentConfirmationStatus? @map("confirmation_status")
  employeeCount            Int                      @default(0) @map("employee_count")
  totalGross               Decimal                  @default(0) @map("total_gross") @db.Decimal(18, 2)
  totalDeductions          Decimal                  @default(0) @map("total_deductions") @db.Decimal(18, 2)
  totalNet                 Decimal                  @default(0) @map("total_net") @db.Decimal(18, 2)
  totalBpjsEmployee        Decimal                  @default(0) @map("total_bpjs_employee") @db.Decimal(18, 2)
  totalBpjsEmployer        Decimal                  @default(0) @map("total_bpjs_employer") @db.Decimal(18, 2)
  totalPph21               Decimal                  @default(0) @map("total_pph21") @db.Decimal(18, 2)
  version                  Int                      @default(1)
  lockedAt                 DateTime?                @map("locked_at")
  projectId                String?                  @map("project_id") @db.Uuid
  payrollGroupId           String?                  @map("payroll_group_id") @db.Uuid
  /// Actual DB column on ImHeroesKiller: locked_by_id
  lockedById               String?                  @map("locked_by_id") @db.Uuid
  snapshotJson             Json?                    @map("snapshot_json")
  calculationVersion       Int                      @default(1) @map("calculation_version")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  company                  Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project                  Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  payrollGroup             PayrollGroup?            @relation(fields: [payrollGroupId], references: [id], onDelete: SetNull)
  sourceBankAccount        BankAccount?             @relation("PayrollSourceAccount", fields: [sourceBankAccountId], references: [id], onDelete: SetNull)
  lockedBy                 User?                    @relation("PayrollPeriodLockedBy", fields: [lockedById], references: [id], onDelete: SetNull)
  lines                    PayrollLine[]
  approvals                ApprovalStep[]
  disbursements            DisbursementBatch[]
  workingCapital           WorkingCapitalRequest[]
  paymentInstructions      PaymentInstruction[]
  paymentConfirmations     PaymentConfirmation[]
  validationIssues         PayrollValidationIssue[]
  payslips                 Payslip[]

  @@index([companyId])
  @@index([status])
  @@index([fundingModel])
  @@index([projectId])
  @@map("payroll_periods")
  @@schema("proqpay")
}

model PayrollLine {
  id              String        @id @default(uuid()) @db.Uuid
  payrollPeriodId String        @map("payroll_period_id") @db.Uuid
  employeeId      String        @map("employee_id") @db.Uuid
  employeeName    String        @map("employee_name")
  department      String
  baseSalary      Decimal       @map("base_salary") @db.Decimal(18, 2)
  allowances      Decimal       @default(0) @db.Decimal(18, 2)
  overtime        Decimal       @default(0) @db.Decimal(18, 2)
  bonuses         Decimal       @default(0) @db.Decimal(18, 2)
  deductions      Decimal       @default(0) @db.Decimal(18, 2)
  tax             Decimal       @default(0) @db.Decimal(18, 2)
  bpjs            Decimal       @default(0) @db.Decimal(18, 2)
  netPay          Decimal       @map("net_pay") @db.Decimal(18, 2)
  componentBreakdown Json?      @map("component_breakdown")
  bpjsEmployer    Decimal?      @default(0) @map("bpjs_employer") @db.Decimal(18, 2)
  pph21           Decimal?      @default(0) @db.Decimal(18, 2)
  grossPay        Decimal?      @default(0) @map("gross_pay") @db.Decimal(18, 2)
  presentDays     Decimal?      @map("present_days") @db.Decimal(8, 2)
  overtimeHours   Decimal?      @map("overtime_hours") @db.Decimal(8, 2)
  isLocked        Boolean       @default(false) @map("is_locked")
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  paymentItems    PaymentInstructionItem[]

  @@index([payrollPeriodId])
  @@index([employeeId])
  @@map("payroll_lines")
  @@schema("proqpay")
}

model ApprovalStep {
  id              String         @id @default(uuid()) @db.Uuid
  payrollPeriodId String         @map("payroll_period_id") @db.Uuid
  level           Int
  approverName    String         @map("approver_name")
  role            Role
  status          ApprovalStatus @default(PENDING)
  comment         String?
  actedAt         DateTime?      @map("acted_at")
  userId          String?        @map("user_id") @db.Uuid
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  payrollPeriod   PayrollPeriod  @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([payrollPeriodId])
  @@map("approval_steps")
  @@schema("proqpay")
}

// Legacy execution batch (kept for compatibility; payment_instructions is primary)
model DisbursementBatch {
  id              String             @id @default(uuid()) @db.Uuid
  payrollPeriodId String             @map("payroll_period_id") @db.Uuid
  periodName      String             @map("period_name")
  bankName        String             @map("bank_name")
  totalAmount     Decimal            @map("grand_total") @db.Decimal(18, 2)
  itemCount       Int                @map("item_count")
  status          DisbursementStatus @default(PENDING)
  referenceNumber String             @map("reference_number")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  processedAt     DateTime?          @map("processed_at")
  payrollPeriod   PayrollPeriod      @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)

  @@index([payrollPeriodId])
  @@index([status])
  @@map("disbursement_batches")
  @@schema("proqpay")
}

// ─── Bank accounts ───────────────────────────────────────

model BankAccount {
  id                        String             @id @default(uuid()) @db.Uuid
  companyId                 String?            @map("company_id") @db.Uuid
  capitalPartnerId          String?            @map("capital_partner_id") @db.Uuid
  purpose                   BankAccountPurpose @default(OTHER)
  bankCode                  String?            @map("bank_code")
  bank                      String
  accountName               String?            @map("account_name")
  account                   String
  maskedAccountNumber       String?            @map("masked_account_number")
  encryptedAccountReference String?            @map("encrypted_account_reference")
  label                     String
  currency                  String             @default("IDR")
  status                    BankAccountStatus  @default(ACTIVE)
  isPrimary                 Boolean            @default(false) @map("is_primary")
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")
  company                   Company?           @relation(fields: [companyId], references: [id], onDelete: SetNull)
  capitalPartner            CapitalPartner?    @relation(fields: [capitalPartnerId], references: [id], onDelete: SetNull)
  payrollPeriods            PayrollPeriod[]    @relation("PayrollSourceAccount")
  paymentInstructions       PaymentInstruction[]

  @@index([companyId])
  @@map("bank_accounts")
  @@schema("proqpay")
}

// ─── Payments ────────────────────────────────────────────

model PaymentInstruction {
  id                   String                    @id @default(uuid()) @db.Uuid
  companyId            String                    @map("company_id") @db.Uuid
  payrollPeriodId      String                    @map("payroll_period_id") @db.Uuid
  instructionNumber    String                    @map("instruction_number")
  fundingModel         PayrollFundingModel       @map("funding_model")
  executionType        PaymentExecutionType      @map("execution_type")
  integrationStatus    BankingIntegrationStatus  @default(SIMULATED) @map("integration_status")
  sourceBankAccountId  String?                   @map("source_bank_account_id") @db.Uuid
  totalRecords         Int                       @default(0) @map("total_records")
  totalAmount          Decimal                   @default(0) @map("total_amount") @db.Decimal(18, 2)
  currency             String                    @default("IDR")
  approvalStatus       ApprovalStatus            @default(PENDING) @map("approval_status")
  executionStatus      PaymentInstructionStatus  @default(DRAFT) @map("execution_status")
  generatedById        String?                   @map("generated_by") @db.Uuid
  generatedAt          DateTime?                 @map("generated_at")
  submittedAt          DateTime?                 @map("submitted_at")
  executedAt           DateTime?                 @map("executed_at")
  failureReason        String?                   @map("failure_reason")
  version              Int                       @default(1)
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  company              Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollPeriod        PayrollPeriod             @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  sourceBankAccount    BankAccount?              @relation(fields: [sourceBankAccountId], references: [id], onDelete: SetNull)
  generatedBy          User?                     @relation("InstructionGeneratedBy", fields: [generatedById], references: [id], onDelete: SetNull)
  items                PaymentInstructionItem[]
  confirmations        PaymentConfirmation[]

  @@unique([companyId, instructionNumber])
  @@index([companyId])
  @@index([payrollPeriodId])
  @@index([executionStatus])
  @@map("payment_instructions")
  @@schema("proqpay")
}

model PaymentInstructionItem {
  id                   String      @id @default(uuid()) @db.Uuid
  paymentInstructionId String      @map("payment_instruction_id") @db.Uuid
  payrollLineId        String?     @map("payroll_line_id") @db.Uuid
  employeeId           String?     @map("employee_id") @db.Uuid
  recipientName        String      @map("recipient_name")
  bankCode             String?     @map("bank_code")
  maskedAccountNumber  String      @map("masked_account_number")
  amount               Decimal     @db.Decimal(18, 2)
  status               String      @default("PENDING")
  externalReference    String?     @map("external_reference")
  failureCode          String?     @map("failure_code")
  failureMessage       String?     @map("failure_message")
  executedAt           DateTime?   @map("executed_at")
  attemptCount         Int         @default(0) @map("attempt_count")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  paymentInstruction   PaymentInstruction @relation(fields: [paymentInstructionId], references: [id], onDelete: Cascade)
  payrollLine          PayrollLine? @relation(fields: [payrollLineId], references: [id], onDelete: SetNull)
  employee             Employee?   @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([paymentInstructionId])
  @@index([employeeId])
  @@map("payment_instruction_items")
  @@schema("proqpay")
}

model WorkingCapitalRequest {
  id                String               @id @default(uuid()) @db.Uuid
  companyId         String?              @map("company_id") @db.Uuid
  payrollPeriodId   String               @map("payroll_period_id") @db.Uuid
  periodName        String               @map("period_name")
  requestNumber     String?              @map("request_number")
  requestedAmount   Decimal              @map("requested_amount") @db.Decimal(18, 2)
  approvedAmount    Decimal              @default(0) @map("approved_amount") @db.Decimal(18, 2)
  fundingFee        Decimal?             @map("funding_fee") @db.Decimal(18, 2)
  interestAmount    Decimal?             @map("interest_amount") @db.Decimal(18, 2)
  tenorDays         Int?                 @map("tenor_days")
  status            WorkingCapitalStatus @default(REQUESTED)
  settlementStatus  SettlementStatus     @default(NOT_STARTED) @map("settlement_status")
  requiredDate      DateTime?            @map("required_date") @db.Date
  repaymentDueDate  DateTime?            @map("repayment_due_date") @db.Date
  createdById       String?              @map("created_by") @db.Uuid
  reviewedById      String?              @map("reviewed_by") @db.Uuid
  approvedById      String?              @map("approved_by") @db.Uuid
  requestedAt       DateTime             @default(now()) @map("requested_at")
  submittedAt       DateTime?            @map("submitted_at")
  approvedAt        DateTime?            @map("approved_at")
  fundedAt          DateTime?            @map("funded_at")
  repaidAt          DateTime?            @map("repaid_at")
  dueDate           DateTime             @map("due_date") @db.Date
  repaidAmount      Decimal              @default(0) @map("repaid_amount") @db.Decimal(18, 2)
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  company           Company?             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  payrollPeriod     PayrollPeriod        @relation(fields: [payrollPeriodId], references: [id], onDelete: Cascade)
  createdBy         User?                @relation("WcCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  reviewedBy        User?                @relation("WcReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  approvedBy        User?                @relation("WcApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  allocations       CapitalAllocation[]

  @@index([payrollPeriodId])
  @@index([companyId])
  @@index([status])
  @@map("working_capital_requests")
  @@schema("proqpay")
}

// ─── Internal commercial ─────────────────────────────────

model SalesOpportunity {
  id                    String            @id @default(uuid()) @db.Uuid
  organizationId        String            @map("organization_id") @db.Uuid
  companyId             String?           @map("company_id") @db.Uuid
  prospectName          String            @map("prospect_name")
  stage                 SalesStage        @default(LEAD)
  estimatedPayrollValue Decimal           @default(0) @map("estimated_payroll_value") @db.Decimal(18, 2)
  probabilityPercentage Int               @default(0) @map("probability_percentage")
  weightedPipelineValue Decimal           @default(0) @map("weighted_pipeline_value") @db.Decimal(18, 2)
  expectedGoLiveDate    DateTime?         @map("expected_go_live_date") @db.Date
  expectedCloseDate     DateTime?         @map("expected_close_date") @db.Date
  fundingInterest       Boolean           @default(false) @map("funding_interest")
  proposedFundingModel  PayrollFundingModel? @map("proposed_funding_model")
