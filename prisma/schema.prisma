// ProQPay Enterprise Payroll OS
// Schema: proqpay on Supabase PostgreSQL
// Models: client-funded payroll + optional working capital + internal commercial ops

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["proqpay"]
}

// ─── Enums ───────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  PAYROLL_ADMIN
  PAYROLL_OPERATOR
  FINANCE
  HR
  DIRECTOR
  APPROVER
  AUDITOR
  VIEWER

  @@schema("proqpay")
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED

  @@schema("proqpay")
}

enum AttendanceType {
  PRESENT
  ABSENT
  LATE
  LEAVE
  SICK
  PERMISSION
  OVERTIME
  HOLIDAY

  @@schema("proqpay")
}

enum PayrollComponentKind {
  BASIC
  ALLOWANCE
  TRANSPORT
  MEAL
  OVERTIME
  BONUS
  INCENTIVE
  COMMISSION
  LOAN
  DEDUCTION
  FINE
  OTHER_INCOME
  OTHER_DEDUCTION
  BPJS_EMPLOYEE
  BPJS_EMPLOYER
  PPH21

  @@schema("proqpay")
}

enum ComponentCalcMethod {
  FIXED
  PERCENT_OF_BASIC
  PERCENT_OF_GROSS
  FORMULA
  ATTENDANCE_BASED

  @@schema("proqpay")
}

enum PayrollStatus {
  DRAFT
  WAITING
  APPROVED
  REJECTED
  LOCKED
  DISBURSED
  /// Confirmation-engine lifecycle (additive)
  PAYMENT_INSTRUCTION_GENERATED
  WAITING_CLIENT_TRANSFER
  TRANSFER_PROOF_UPLOADED
  UNDER_VERIFICATION
  VERIFIED
  CLOSED

  @@schema("proqpay")
}

enum PaymentConfirmationStatus {
  UPLOADED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  NEED_REVISION

  @@schema("proqpay")
}

/// How the client executes salary transfers after the instruction is issued.
enum PaymentExecutionModel {
  CLIENT_SELF_TRANSFER
  WORKING_CAPITAL
  BANK_API
  MANUAL

  @@schema("proqpay")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED

  @@schema("proqpay")
}

enum DisbursementStatus {
  PENDING
  PAID
  FAILED

  @@schema("proqpay")
}

/// Legacy + expanded working-capital lifecycle (additive).
enum WorkingCapitalStatus {
  REQUESTED
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  ALLOCATING
  DISBURSED
  FUNDED
  OUTSTANDING
  SETTLEMENT_DUE
  PARTIALLY_REPAID
  REPAID
  OVERDUE
  CANCELLED

  @@schema("proqpay")
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  RESIGNED
  TERMINATED

  @@schema("proqpay")
}

enum PayrollFundingModel {
  SELF_FUNDED
  WORKING_CAPITAL

  @@schema("proqpay")
}

enum ClientLifecycleStatus {
  LEAD
  PROSPECT
  ONBOARDING
  ACTIVE
  SUSPENDED
  INACTIVE
  ARCHIVED

  @@schema("proqpay")
}

enum WorkingCapitalFacilityStatus {
  NOT_ENABLED
  ENABLED
  SUSPENDED
  EXHAUSTED

  @@schema("proqpay")
}

enum BankAccountPurpose {
  CLIENT_PAYROLL_SOURCE
