}

model PayrollValidation {
  id            String              @id @default(uuid()) @db.Uuid
  calculationId String              @map("calculation_id") @db.Uuid
  code          String
  severity      ValidationSeverity  @default(WARNING)
  message       String
  employeeId    String?             @map("employee_id") @db.Uuid
  employeeName  String?             @map("employee_name")
  createdAt     DateTime            @default(now()) @map("created_at")
  calculation   PayrollCalculation  @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@index([calculationId])
  @@index([severity])
  @@map("payroll_validations")
  @@schema("proqpay")
}

model PayrollApproval {
  id            String   @id @default(uuid()) @db.Uuid
  calculationId String   @map("calculation_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  name          String   @default("Default payroll approval")
  status        String   @default("PENDING")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  calculation   PayrollCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  steps         PayrollApprovalStep[]

  @@index([calculationId])
  @@index([companyId])
  @@map("payroll_approvals")
  @@schema("proqpay")
}

model PayrollApprovalStep {
  id          String               @id @default(uuid()) @db.Uuid
  approvalId  String               @map("approval_id") @db.Uuid
  level       Int
  roleLabel   String               @map("role_label")
  assigneeName String?             @map("assignee_name")
  status      String               @default("PENDING")
  action      EngineApprovalAction?
  comment     String?
  actedAt     DateTime?            @map("acted_at")
  actedById   String?              @map("acted_by") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  approval    PayrollApproval      @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@index([approvalId])
  @@map("payroll_approval_steps")
  @@schema("proqpay")
}

model PayrollRevision {
  id              String   @id @default(uuid()) @db.Uuid
  calculationId   String   @map("calculation_id") @db.Uuid
  revisionNumber  Int      @map("revision_number")
  reason          String
  baseRevision    Int?     @map("base_revision")
  snapshotJson    String?  @map("snapshot_json")
  createdById     String?  @map("created_by") @db.Uuid
  createdByName   String?  @map("created_by_name")
  createdAt       DateTime @default(now()) @map("created_at")
  calculation     PayrollCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)

  @@unique([calculationId, revisionNumber])
  @@index([calculationId])
  @@map("payroll_revisions")
  @@schema("proqpay")
}

model PayrollJournal {
  id                String   @id @default(uuid()) @db.Uuid
  calculationId     String   @unique @map("calculation_id") @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  grossPayroll      Decimal  @default(0) @map("gross_payroll") @db.Decimal(18, 2)
  netPayroll        Decimal  @default(0) @map("net_payroll") @db.Decimal(18, 2)
  allowanceTotal    Decimal  @default(0) @map("allowance_total") @db.Decimal(18, 2)
  deductionTotal    Decimal  @default(0) @map("deduction_total") @db.Decimal(18, 2)
  employerCost      Decimal  @default(0) @map("employer_cost") @db.Decimal(18, 2)
  employeeCost      Decimal  @default(0) @map("employee_cost") @db.Decimal(18, 2)
  bpjsEmployer      Decimal  @default(0) @map("bpjs_employer") @db.Decimal(18, 2)
  bpjsEmployee      Decimal  @default(0) @map("bpjs_employee") @db.Decimal(18, 2)
  taxTotal          Decimal  @default(0) @map("tax_total") @db.Decimal(18, 2)
  workingCapitalRequirement Decimal @default(0) @map("working_capital_requirement") @db.Decimal(18, 2)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  calculation       PayrollCalculation @relation(fields: [calculationId], references: [id], onDelete: Cascade)
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("payroll_journals")
  @@schema("proqpay")
}

model PayrollBudget {
  id          String          @id @default(uuid()) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  name        String
  scopeType   BudgetScopeType @default(COMPANY) @map("scope_type")
  scopeId     String?         @map("scope_id")
  periodLabel String?         @map("period_label")
  amount      Decimal         @db.Decimal(18, 2)
  currency    String          @default("IDR")
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  allocations PayrollBudgetAllocation[]

  @@index([companyId])
  @@map("payroll_budgets")
  @@schema("proqpay")
}

model PayrollBudgetAllocation {
  id        String   @id @default(uuid()) @db.Uuid
  budgetId  String   @map("budget_id") @db.Uuid
  label     String
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  budget    PayrollBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@map("payroll_budget_allocations")
  @@schema("proqpay")
}
